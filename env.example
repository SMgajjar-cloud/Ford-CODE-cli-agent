# FORD CODE Environment Configuration
# Copy this file to .env and configure your desired model keys

# DeepSeek Engine (Default: Mustang GT / Bronco Raptor)
DEEPSEEK_API_KEY=""

# OpenAI Engine (GT Supercar)
OPENAI_API_KEY=""

# Anthropic Engine (F-150 Lightning)
ANTHROPIC_API_KEY=""

# Google Gemini Engine (Mustang Mach-E GT)
GEMINI_API_KEY=""

# Local Ollama Host (Explorer EV)
OLLAMA_HOST="http://localhost:11434"

# Web Companion Server Port
FORD_WEB_PORT=3456
